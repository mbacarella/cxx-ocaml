#############################################
# Rule for running custom commands.

rule CUSTOM_COMMAND
  command = $COMMAND
  description = $DESC


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /nix/store/7va01f1pa6bkxy2a869dx148ajxx16dd-cmake-3.31.6/bin/cmake --regenerate-during-build -S/home/mbac/code/c++caml/cxx -B/home/mbac/code/c++caml/cxx/build-release
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /nix/store/vzhaimx1jdsx680i85j3rh8qn0n3fak7-ninja-1.12.1/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /nix/store/vzhaimx1jdsx680i85j3rh8qn0n3fak7-ninja-1.12.1/bin/ninja -t targets
  description = All primary targets available:

